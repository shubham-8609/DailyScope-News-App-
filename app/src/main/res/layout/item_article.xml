<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_10sdp"
    android:layout_marginVertical="@dimen/_6sdp"
    app:cardCornerRadius="@dimen/_16sdp"
    app:cardElevation="6dp"
    app:strokeColor="?attr/colorOutline"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
    app:strokeWidth="1dp"
    android:clickable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- News Image -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/newsImage"
            android:layout_width="0dp"
            android:layout_height="@dimen/_150sdp"
            android:scaleType="centerCrop"
            android:src="@drawable/news_placeholder"
            app:shapeAppearanceOverlay="@style/RoundedTopImage"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Gradient Overlay -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/black_gradient_overlay"
            app:layout_constraintTop_toTopOf="@id/newsImage"
            app:layout_constraintBottom_toBottomOf="@id/newsImage"
            app:layout_constraintStart_toStartOf="@id/newsImage"
            app:layout_constraintEnd_toEndOf="@id/newsImage"/>

        <!-- Category Chip -->
        <com.google.android.material.chip.Chip
            android:id="@+id/categoryChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Technology"
            android:textSize="11sp"
            android:textColor="@android:color/white"
            android:layout_margin="10dp"
            app:chipBackgroundColor="?attr/colorPrimaryContainer"
            app:chipCornerRadius="10dp"
            android:backgroundTint="#66000000"
            app:layout_constraintTop_toTopOf="@id/newsImage"
            app:layout_constraintStart_toStartOf="@id/newsImage"/>

        <!-- Bookmark Icon -->
        <ImageButton
            android:id="@+id/bookmarkBtn"
            android:layout_width="36dp"
            android:backgroundTint="?attr/colorSurfaceContainerHighest"
            android:elevation="4dp"
            android:padding="6dp"
            android:layout_height="36dp"
            android:layout_margin="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/icon_bookmark"
            app:layout_constraintTop_toTopOf="@id/newsImage"
            app:layout_constraintEnd_toEndOf="@id/newsImage"
       />

        <!-- Title -->
        <TextView
            android:id="@+id/newsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:maxLines="2"
            android:paddingHorizontal="10dp"
            android:paddingBottom="@dimen/_6sdp"
            android:lineSpacingExtra="2dp"
            android:ellipsize="end"
            app:layout_constraintBottom_toBottomOf="@id/newsImage"
            app:layout_constraintStart_toStartOf="@id/newsImage"
            app:layout_constraintEnd_toEndOf="@id/newsImage"/>

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            app:layout_constraintTop_toBottomOf="@id/newsImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Summary -->
            <TextView
                android:id="@+id/newsSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp"/>

            <!-- Meta Info -->
            <TextView
                android:id="@+id/newsMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="8dp"
                android:maxLines="1"
                android:ellipsize="end"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
