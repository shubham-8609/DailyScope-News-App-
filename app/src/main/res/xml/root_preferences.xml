<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- ================= NEWS FETCH OPTIONS ================= -->

    <PreferenceCategory app:title="Top-news fetch Options">

        <SwitchPreferenceCompat
            app:enabled="false"
            app:key="headlines_only"
            app:summary="Fetch headlines only in top news "
            app:title="Headlines Only"

            />

        <EditTextPreference
            app:defaultValue="1"
            app:key="max_news_per_cluster"
            app:summary="Maximum articles fetched per news cluster"
            app:title="Max News Per Cluster"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:key="news_date"
            app:summary="Format: YYYY-MM-DD (leave empty for today)"
            app:title="Fetch News For Date"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>


    <!-- ================= APP PREFERENCES ================= -->

    <PreferenceCategory app:title="Application Settings">

        <SwitchPreferenceCompat
            app:enabled="false"
            app:key="sync"
            app:summary="Automatically refresh news in background"
            app:title="Auto Sync News" />

        <SwitchPreferenceCompat
            app:dependency="sync"
            app:key="attachment"
            app:summaryOff="Images will not be downloaded"
            app:summaryOn="Images will be downloaded"
            app:title="Download Images" />

    </PreferenceCategory>

    <!-- ================= STORAGE MANAGEMENT ================= -->


    <PreferenceCategory app:title="Cache Options">

        <Preference
            app:key="cache_size"
            app:summary="Calculating..."
            app:title="Current Cache Size" />

        <Preference
            app:key="delete_all_news"
            app:summary="Remove all stored news articles from the local database"
            app:title="Delete All News" />

        <Preference
            app:key="clear_images"
            app:summary="Remove all downloaded news images"
            app:title="Clear Downloaded Images" />

        <Preference
            app:key="clear_database"
            app:summary="Delete all saved articles and reset app"
            app:title="Reset Local Database" />

    </PreferenceCategory>

    <!-- ================= ABOUT APPLICATION ================= -->

    <PreferenceCategory app:title="About Application">

        <Preference
            app:key="app_version"
            app:summary="1.0.0"
            app:title="App Version" />

        <Preference
            app:key="app_description"
            app:summary="DailyScope is a modern news reader built with Kotlin, MVVM, Room, and Retrofit. It aggregates global news and allows powerful filtering and offline access."
            app:title="About DailyScope" />

    </PreferenceCategory>

    <!-- ================= ABOUT DEVELOPER ================= -->

    <PreferenceCategory app:title="About Developer">

        <Preference
            app:key="developer_name"
            app:summary="Shubham"
            app:title="Developer" />

        <Preference
            app:key="github"
            app:summary="View project source code"
            app:title="GitHub Repository" />

        <Preference
            app:key="contact"
            app:summary="Send feedback or report bugs"
            app:title="Contact Developer" />

    </PreferenceCategory>

</PreferenceScreen>